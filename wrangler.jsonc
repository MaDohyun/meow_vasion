{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stack-runner-room",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-17",
  "durable_objects": {
    "bindings": [
      {
        "name": "STACK_RUNNER_ROOMS",
        "class_name": "StackRunnerRoom"
      }
    ]
  },
  "exports": {
    "StackRunnerRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
